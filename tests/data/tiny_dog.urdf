<robot name="tiny_dog">
<link name="body"><visual><origin xyz="0 0 0"/><geometry><box size="0.4 0.2 0.08"/></geometry></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.4 0.2 0.08"/></geometry></collision><inertial><origin xyz="0 0 0"/><mass value="6.0"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
<link name="fl_thigh"><visual><origin xyz="0 0 -0.08"/><geometry><cylinder radius="0.02" length="0.16"/></geometry></visual><collision><origin xyz="0 0 -0.08"/><geometry><cylinder radius="0.02" length="0.16"/></geometry></collision><inertial><origin xyz="0 0 -0.08"/><mass value="0.4"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
