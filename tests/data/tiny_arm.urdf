<robot name="tiny_arm">
<link name="base"><visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.06" length="0.1"/></geometry></visual><collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.06" length="0.1"/></geometry></collision><inertial><origin xyz="0 0 0.05"/><mass value="2.0"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
